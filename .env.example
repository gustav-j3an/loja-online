# =========================================================
# CONFIGURAÇÃO DE CONEXÃO COM O SUPABASE (MODO REAL)
# =========================================================
# Substitua os valores abaixo pelas credenciais obtidas no seu projeto em https://supabase.com
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica-aqui

# ATENÇÃO DE SEGURANÇA: NUNCA insira a VITE_SUPABASE_SERVICE_ROLE_KEY no frontend!

# =========================================================
# MODO DEMONSTRATIVO (DESENVOLVIMENTO LOCAL APENAS)
# =========================================================
# Para rodar com dados locais de teste em ambiente de dev sem conectar ao Supabase, defina:
# VITE_DEMO_MODE=true
